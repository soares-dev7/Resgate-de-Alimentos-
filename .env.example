# Copie para .env.local:  cp .env.example .env.local
# NENHUMA variável é obrigatória: sem o Supabase, o app roda no modo local de
# demonstração (dados mockados salvos no navegador).

# Supabase (Project Settings > API). Preencha as duas para usar o banco compartilhado.
# Use a chave pública "anon" / "publishable" — NUNCA a service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (Opcional) Servidor de tiles do mapa. Padrão: tiles públicos do OpenStreetMap.
# Ex.: https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_URL=

# --- Próximas fases (ainda NÃO usadas pelo código) ---------------------------

# API de rotas real (ex.: OpenRouteService). Use só no servidor, nunca com NEXT_PUBLIC_.
# ORS_API_KEY=
